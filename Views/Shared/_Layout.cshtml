<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - ProjectSpetses</title>
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/ProjectSpetses.styles.css" asp-append-version="true" />
</head>
<body>
    <header>
        <nav class="navbar navbar-expand-sm navbar-toggleable-sm navbar-light bg-white border-bottom box-shadow mb-3">
            <div class="container-fluid">
                <a class="navbar-brand" asp-area="" asp-controller="Home" asp-action="Index">ProjectSpetses</a>
                <button class="navbar-toggler" type="button" data-bs-toggle="collapse" data-bs-target=".navbar-collapse" aria-controls="navbarSupportedContent"
                        aria-expanded="false" aria-label="Toggle navigation">
                    <span class="navbar-toggler-icon"></span>
                </button>
                <div class="navbar-collapse collapse d-sm-inline-flex justify-content-between">
                    <ul class="navbar-nav flex-grow-1">
                        <li class="nav-item">
                            <a class="nav-link text-black"
                               asp-controller="@nameof(HomeController)[..nameof(HomeController).LastIndexOf("Controller")]"
                               asp-action="@nameof(HomeController.Index)">
                                Home
                            </a>
                            @*
                                same thing as this but done dynamically
                                <a class="nav-link text-dark" asp-area="" asp-controller="Home" asp-action="Index">Home</a>
                            *@
                        </li>
                        @if (!User.Identity.IsAuthenticated)
                        {
                            @* Navigation for guests (not logged in) *@
                            <li class="nav-item">
                                <a class="nav-link text-black"
                                   asp-controller="@nameof(LoginController)[..nameof(LoginController).LastIndexOf("Controller")]"
                                   asp-action="@nameof(LoginController.Login)">
                                    Login
                                </a>
                            </li>
                        }
                        else
                        {
                            @* Content for logged-in users *@ 
                            <li class="nav-item">
                                <a class="nav-link text-black"
                                   asp-controller="@nameof(ExploreController)[..nameof(ExploreController).LastIndexOf("Controller")]"
                                   asp-action="@nameof(ExploreController.Index)">
                                    Explore
                                </a>
                            </li>
                            <li class="nav-item">
                                <a class="nav-link text-black"
                                   asp-controller="@nameof(GamesController)[..nameof(GamesController).LastIndexOf("Controller")]"
                                   asp-action="@nameof(GamesController.Index)">
                                    Games
                                </a>
                            </li>
                            <li class="nav-item">
                                <a class="nav-link text-black"
                                   asp-controller="@nameof(LoginController)[..nameof(LoginController).LastIndexOf("Controller")]"
                                   asp-action="@nameof(LoginController.Logout)">
                                    Logout
                                </a>
                            </li>
                        }
                        
                    </ul>
                </div>
            </div>
        </nav>
    </header>
    <div class="container">
        <main role="main" class="pb-3">
            @RenderBody()
        </main>
    </div>

    <footer class="border-top footer text-muted">
        <div class="container">
            &copy; 2025 - ProjectSpetses - <a asp-area="" asp-controller="Home" asp-action="Privacy">Privacy</a>
        </div>
    </footer>
    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    <script src="~/js/site.js" asp-append-version="true"></script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
