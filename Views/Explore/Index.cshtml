@model ExploreViewModel
@{
    ViewData["Title"] = "Ενότητες";
}

<link rel="stylesheet" href="~/css/explore.css" />

@if (Model.Sections.Count == 0)
{
    <div class="text-center">
        <h3 class="display-4">Δεν υπάρχουν ενότητες αυτή τη στιγμή</h3>
    </div>
}
else
{
    <div>
        <h2>Επιλέξτε Ενότητα</h2>
        @* NOTE: section is a keyword (like @model), so avoid using it after '@'*@
        @for (int i = 0; i < Model.Sections.Count; i++)
        {
            var exploreSection = Model.Sections[i];
            if (exploreSection.PointsRequired > Model.Points)
            {
                <a class="section-card-link locked">
                    <div class="section-card locked">
                        <div class="section-thumbnail">
                            <img src="@exploreSection.ImageUrl" class="img-fluid rounded-start" alt="@exploreSection.Name">
                        </div>
                        <div class="section-details">
                            <div class="section-title">
                                @exploreSection.Name
                            </div>
                            <p class="section-description">@exploreSection.Description</p>
                        </div>
                        <div class="lock-overlay">
                            <span class="lock-icon">🔒</span>
                            <div class="points-required">@Model.Points/@exploreSection.PointsRequired</div>
                        </div>
                    </div>
                </a>
            }
            else
            {
                <a asp-controller="@nameof(ExploreController)[..nameof(ExploreController).LastIndexOf("Controller")]"
                   asp-action="@nameof(ExploreController.Section)"
                   asp-route-Id="@exploreSection.Id"
                   class="section-card-link @(Model.CompletedCategories[i] == Model.CategoryCount[i] ? "completed" : "")">
                    <div class="section-card @(Model.CompletedCategories[i] == Model.CategoryCount[i] ? "completed" : "")">
                        <div class="section-thumbnail">
                            <img src="@exploreSection.ImageUrl" class="img-fluid rounded-start" alt="@exploreSection.Name">
                        </div>
                        <div class="section-details">
                            <div class="section-title">
                                @exploreSection.Name
                            </div>
                            <p class="section-description">@exploreSection.Description</p>
                        </div>
                        @if (Model.CompletedCategories[i] == Model.CategoryCount[i])
                        {
                            <div class="completion-overlay">
                                <span class="check-icon">✓</span>
                                <div class="categories-progress">@Model.CompletedCategories[i]/@Model.CategoryCount[i]</div>
                            </div>
                        }
                        else
                        {
                            <div class="progress-overlay">
                                @Model.CompletedCategories[i]/@Model.CategoryCount[i]
                            </div>
                        }
                    </div>
                </a>
            }
        }
    </div>
}