@model RegisterViewModel
@{
    ViewData["Title"] = "Sign Up";
}

<h2>Sign Up</h2>

<div class="mt-3">
    <form asp-action="@nameof(LoginController.Register)" method="post">
        @if (ViewData.ModelState.ContainsKey("RegisterCredentials"))
        {
            <div class="alert alert-danger">
                @ViewData.ModelState["RegisterCredentials"].Errors.First().ErrorMessage
            </div>
        }
        <div class="mt-3">
            <label class="form-label">Username</label>
            <input type="text" class="form-control" asp-for="Username" />
            <span asp-validation-for="Username" class="text-danger"></span>
        </div>
        <div class="mt-3">
            <label class="form-label">Password</label>
            <input type="password" class="form-control" asp-for="Password" />
            <span asp-validation-for="Password" class="text-danger"></span>
        </div>
        <div class="mt-3">
            <label class="form-label">Confirm Password</label>
            <input type="password" class="form-control" asp-for="ConfirmPassword" />
            <span asp-validation-for="ConfirmPassword" class="text-danger"></span>
        </div>
        <div class="mt-3">
            <button type="submit" class="btn btn-primary">Sign Up</button>
        </div>
    </form>

    <div class="mt-3">
        <a asp-action="@nameof(LoginController.Login)">Login</a>
    </div>
</div>
