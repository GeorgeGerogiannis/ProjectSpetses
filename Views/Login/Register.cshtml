@model RegisterViewModel
@{
    ViewData["Title"] = "Δημιουργία Λογαριασμού";
}
<link rel="stylesheet" href="~/css/login_register.css" />

<div class="title">Δημιουργίστε Λογαριασμό</div>

<div class="mt-3">
    <form asp-action="@nameof(LoginController.Register)" method="post">
        @if (ViewData.ModelState.ContainsKey("RegisterCredentials"))
        {
            <div class="alert alert-danger">
                @ViewData.ModelState["RegisterCredentials"].Errors.First().ErrorMessage
            </div>
        }
        <div class="mt-3">
            <label class="form-label">Όνομα Χρήστη</label>
            <input type="text" class="form-control" asp-for="Username" />
            <span asp-validation-for="Username" class="text-danger"></span>
        </div>
        <div class="mt-3">
            <label class="form-label">Κωδικός Πρόσβασης</label>
            <input type="password" class="form-control" asp-for="Password" />
            <span asp-validation-for="Password" class="text-danger"></span>
        </div>
        <div class="mt-3">
            <label class="form-label">Επιβεβαίωση Κωδικού Πράσβασης</label>
            <input type="password" class="form-control" asp-for="ConfirmPassword" />
            <span asp-validation-for="ConfirmPassword" class="text-danger"></span>
        </div>
        <div class="mt-3">
            <button type="submit" class="btn btn-primary">Δημιουργία Λογαριασμού</button>
        </div>
    </form>

    <div class="mt-3">
        <a asp-action="@nameof(LoginController.Login)"
           class="btn btn-secondary">
            Σύνδεση
        </a>
    </div>
</div>
