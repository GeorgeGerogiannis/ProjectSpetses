@model LoginViewModel
@{
    ViewData["Title"] = "Σύνδεση";
}

<h2>Σύνδεθείτε</h2>

<div class="mt-3">
    <form asp-action="@nameof(LoginController.Login)" method="post">
        @if (ViewData.ModelState.ContainsKey("LoginCredentials"))
        {
            <div class="alert alert-danger">
                @ViewData.ModelState["LoginCredentials"].Errors.First().ErrorMessage
            </div>
        }
        <div class="mt-3">
            <label class="form-label">Όνομα Χρήστη</label>
            <input type="text" class="form-control" asp-for="Username" />
            <span asp-validation-for="Username" class="text-danger"></span>
        </div>
        <div class="mt-3">
            <label class="form-label">Κωδικός Πρόσβασης</label>
            <input type="password" class="form-control" asp-for="Password" />
            <span asp-validation-for="Password" class="text-danger"></span>
        </div>
        <div class="mt-3">
            <button type="submit" class="btn btn-primary">Σύνδεση</button>
        </div>
    </form>

    <div class="mt-3">
        <a asp-action="@nameof(LoginController.Register)">Δημιουργία Λογαριασμού</a>
    </div>
</div>
