@model StatsViewModel
@{
    ViewData["Title"] = "Στατιστικά";
}

<link rel="stylesheet" href="~/css/stats.css" />
<link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.0/css/all.min.css" />

<div class="row justify-content-center mb-5">
    <div class="col-lg-8">
        <div class="progress-card slide-up">
            <div class="progress-card-header">
                <h3><i class="fas fa-chart-line me-2"></i> Στατιστικά - @Model.Username</h3>
            </div>
            <div class="progress-card-body">
                <div class="progress-details">
                    <div class="detail-item">
                       
                        <span class="detail-label"><i class="fas fa-calendar-alt text-primary"></i>Μαθαίνετε από τις:</span>
                        <span class="detail-value">@Model.CreatedAt.ToString("d MMMM, yyyy")</span>
                    </div>
                    <div class="detail-item">
                        
                        <span class="detail-label"><i class="fas fa-coins text-warning"></i>Πόντοι:</span>
                        <span class="detail-value">@Model.TotalPoints</span>
                    </div>
                    <div class="detail-item">
                        
                        <span class="detail-label"><i class="fas fa-layer-group text-success"></i>Ολοκληρομένες Eνότητες:</span>
                        <span class="detail-value">@Model.SectionsCompleted</span>
                    </div>
                    <div class="detail-item">
                        
                        <span class="detail-label"><i class="fas fa-list-alt text-info"></i>Ολοκληρομένες Υποενότητες:</span>
                        <span class="detail-value">@Model.CategoriesCompleted</span>
                    </div>
                    <div class="detail-item">
                        
                        <span class="detail-label"><i class="fas fa-check-circle text-success"></i>Σωστές Απαντήσεις:</span>
                        <span class="detail-value">@Model.CorrectAnswers</span>
                    </div>
                    <div class="detail-item">
                        
                        <span class="detail-label"><i class="fas fa-times-circle text-danger"></i>Λάθος Απαντήσεις:</span>
                        <span class="detail-value">@Model.WrongAnswers</span>
                    </div>
                    <div class="detail-item">
                        
                        <span class="detail-label"><i class="fas fa-balance-scale text-secondary"></i>Λόγος (Σωστές/Λάθος):</span>
                        <span class="detail-value">@(Model.WrongAnswers != 0 ? (float)Model.CorrectAnswers / (float)Model.WrongAnswers : "0")</span>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>
