@model StatsViewModel
@{
    ViewData["Title"] = "Στατιστικά";
}

<link rel="stylesheet" href="~/css/stats.css" />

<div class="title">Στατιστικά - @Model.Username</div>
<p>
    Μαθένετε από τις @Model.CreatedAt.ToString("d MMMM, yyyy")
    Πόντοι: @Model.TotalPoints
    Ολοκληρομένες Eνότητες: @Model.SectionsCompleted
    Ολοκληρομένες Υποενότητες: @Model.CategoriesCompleted
    Σωστές Απαντήσεις/Λάθος Απαντήσεις: @Model.CorrectAnswers/@Model.WrongAnswers (Λόγος: @(Model.WrongAnswers != 0 ? Model.CorrectAnswers/Model.WrongAnswers : "0"))
</p>

