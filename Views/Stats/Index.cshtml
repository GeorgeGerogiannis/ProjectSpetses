@model StatsViewModel
@{
    ViewData["Title"] = "Στατιστικά";
}

<h1>Στατιστικά - @Model.Username</h1>
<p>Μαθένετε από τις @Model.CreatedAt.ToString("d MMMM, yyyy")</p>
<p>Πόντοι: @Model.TotalPoints</p>
<p>Ολοκληρομένες Eνότητες: @Model.SectionsCompleted</p>
<p>Ολοκληρομένες Υποενότητες: @Model.CategoriesCompleted</p>
