@model HomeViewModel
@{
    ViewData["Title"] = "Home Page";
}

<link rel="stylesheet" href="~/css/home.css" />

<div class="container text-center">
    @if (User.Identity.IsAuthenticated)
    {
        <h2>
            Καλωσήρθατε, στο ProjectSpetses @User.Identity.Name!
        </h2>
        <p>
            Μάθετε για τις Σπέτσες
            <a asp-controller="@nameof(ExploreController)[..nameof(ExploreController).LastIndexOf("Controller")]"
               asp-action="@nameof(ExploreController.Index)">
                εδώ
            </a>.
        </p>

        @if (Model != null)
        {
            <div class="last-read-card">
                <div class="last-read-card-body">
                    <h5 class="last-read-card-title">Που σταμάτησες τελευταία φορά?</h5>
                    <p class="last-read-card-text">
                        Ενότητα: @Model.SectionName
                        Υποενότητα: @Model.CategoryName
                        Σελίδα: @Model.Page
                    </p>
                    <a class="btn btn-primary"
                       asp-controller="@nameof(ExploreController)[..nameof(ExploreController).LastIndexOf("Controller")]"
                       asp-action="@nameof(ExploreController.Category)"
                       asp-route-sectionId="@Model.SectionId"
                       asp-route-Id="@Model.CategoryId"
                       asp-route-page="@Model.Page">
                        Συνέχισε το διάβασμα
                    </a>
                </div>
            </div>
        }
    }
    else
    {
        <h2>
            Καλωσήρθατε! Παρακαλώ συνδεθείτε
            <a asp-controller="@nameof(LoginController)[..nameof(LoginController).LastIndexOf("Controller")]"
               asp-action="@nameof(LoginController.Login)">
                εδώ
            </a>
            για να απολαύσετε την εμπειρία μας.
        </h2>
    }
</div>
