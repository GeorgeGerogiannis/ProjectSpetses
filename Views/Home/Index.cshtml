@{
    ViewData["Title"] = "Home Page";
}

<div class="text-center">
    @if (User.Identity.IsAuthenticated)
    {
        <h2>
            Καλωσήρθατε, στο ProjectSpetses @User.Identity.Name!
        </h2>
        <p>
            Μάθετε για τις Σπέτσες
            <a asp-controller="@nameof(ExploreController)[..nameof(ExploreController).LastIndexOf("Controller")]"
               asp-action="@nameof(ExploreController.Index)">
                εδώ
            </a>.
        </p>
    }
    else
    {
        <h2>
            Καλωσήρθατε! Παρακαλώ συνδεθείτε
            <a asp-controller="@nameof(LoginController)[..nameof(LoginController).LastIndexOf("Controller")]"
               asp-action="@nameof(LoginController.Login)">
                εδώ
            </a>
            για να απολαύσετε την εμπειρία μας.
        </h2>
    }
    
</div>
