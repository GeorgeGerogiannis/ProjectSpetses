@model ProjectSpetses.Models.GameSubmissionViewModel

<link rel="stylesheet" href="~/css/results.css" />

<div class="results-container">
    <h2>Αποτελέσματα</h2>

    <div class="results-content">
        <div class="answer-indicators">
            @foreach (var item in Model.Answers)
            {
                <span class="indicator @(item.SelectedValue == "True" ? "correct" : "incorrect")"></span>
            }
        </div>

        @{
            var correctAnswers = 0;
            var totalAnswers = Model.Answers.Count;
        }
        @foreach (var item in Model.Answers)
        {
            if (item.SelectedValue == "True")
            {
                correctAnswers++;
            }
        }

        <div class="score-display">
            <span class="score">@correctAnswers / @totalAnswers</span>
        </div>

        <a class="btn-return"
           asp-controller="@nameof(HomeController)[..nameof(HomeController).LastIndexOf("Controller")]"
           asp-action="@nameof(HomeController.Index)">
            Επιστροφή στην Αρχική Σελίδα
        </a>
    </div>
</div>
