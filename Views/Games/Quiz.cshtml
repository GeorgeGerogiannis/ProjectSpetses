@model ProjectSpetses.Models.Entities.Quiz_item

<h1>Quizzes</h1>
<form asp-action="@nameof(GamesController.SubmitQuiz)" method="post">

    <div>
        <h3>@Model.Description</h3>
        <input type="hidden" name="Answers[0].QuestionId" value="@Model.Id" />
        <input type="hidden" name="Answers[0].GameType" value="Quiz" />
        <ul>
            @foreach (var answer in Model.Answers)
            {
                <li>
                    <input type="radio"
                            id="@Model.Id@answer"
                            name="Answers[0].SelectedValue"
                            value="@(Model.Solution == answer ? "True" : "False")"
                            required />
                    <label for="@Model.Id@answer">
                        @answer
                    </label>
                </li>
            }
        </ul>
    </div>

    <button type="submit">Submit</button>
</form>

