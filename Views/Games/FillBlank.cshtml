@model List<ProjectSpetses.Models.Entities.Blank_item>

<h1>Fill the blanks!</h1>
<form asp-action="@nameof(GamesController.SubmitQuiz)" method="post">

    @foreach (var quiz in Model)
    {
        <div>
            <h3>@quiz.Description1 ____ @quiz.Description2</h3>
            <ul>
                @foreach (var answer in quiz.Answers)
                {
                    <li>
                        <input type="radio"
                               id="@quiz.Section_Id@answer"
                               name="@quiz.Section_Id"
                               value="@(quiz.Solution == answer ? "True" : "False")"
                               required />
                        <!-- The Value is visible if you inspect the browser page, this is a feature -->
                        <label for="@quiz.Section_Id@answer">@answer</label>
                    </li>
                }
            </ul>
        </div>
    }

    <button type="submit">Submit</button>
</form>