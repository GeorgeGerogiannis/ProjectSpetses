@model ProjectSpetses.Models.Entities.Blank_item

<link rel="stylesheet" href="~/css/quiz.css" />

<h1>Fill the blanks!</h1>
<form asp-action="@nameof(GamesController.SubmitFillBlank)" method="post">

    <div>
        <h3>
            <span id="desc1">@Model.Description1</span>
            <span id="blank"> ____ </span>
            <span id="desc2">@Model.Description2</span>
        </h3>
        <input type="hidden" name="Answers[0].QuestionId" value="@Model.Id" />
        <input type="hidden" name="Answers[0].GameType" value="FillBlank" />
        <ul class="item-list">
            @foreach (var answer in Model.Answers)
            {
                <li class="item">
                    <input type="radio"
                           id="@Model.Id@answer"
                           name="Answers[0].SelectedValue"
                           value="@(Model.Solution == answer ? "True" : "False")"
                           data-answer-text="@answer"
                           required
                           onchange="updateBlankText(this)" />
                    <label for="@Model.Id@answer">
                        @answer
                    </label>
                </li>
            }
        </ul>
    </div>

    <button type="submit">SUBMIT</button>
</form>

<script>
    function updateBlankText(radio) {
        var blankSpan = document.getElementById('blank');
        if (radio.checked) {
            blankSpan.textContent = ' ' + radio.getAttribute('data-answer-text') + ' ';
        }
    }

    //if any radio is checked, update the blank
    document.addEventListener('DOMContentLoaded', function () {
        var radios = document.querySelectorAll('input[type="radio"][name="Answers[0].SelectedValue"]');
        radios.forEach(function (radio) {
            radio.addEventListener('change', function () {
                updateBlankText(radio);
            });
            if (radio.checked) {
                updateBlankText(radio);
            }
        });
    });
</script>
